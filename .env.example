# ── 数据库（Zeabur 加了 PostgreSQL 服务后会自动注入）──
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ── LLM Provider：claude 或 deepseek ──
LLM_PROVIDER=claude

# ── Claude ──
ANTHROPIC_KEY=sk-ant-your-key-here
MODEL_MAIN=claude-sonnet-4-5-20250929
MODEL_JP_AUX=claude-haiku-4-5-20251001

# ── DeepSeek ──
DEEPSEEK_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── Fish Audio TTS（语音，可选）──
FISH_KEY=
FISH_VOICE_ID=

# ── 默认角色 id ──
DEFAULT_CHARACTER_ID=default

# ── RAG（可选，记忆上千条后再开。也可在 App 设置页改，不用动 Zeabur）──
USE_RAG=0
EMBED_API_KEY=
EMBED_BASE_URL=
EMBED_MODEL=embedding-3
EMBED_DIM=1024